{
  "name": "vernacular",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "qloo:smoke": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/qloo-smoke.ts",
    "qloo:data-test": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/data-test.ts",
    "qloo:confirm-test": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/confirm-test.ts",
    "check": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/check.ts",
    "mcp:smoke": "tsx scripts/mcp-smoke.ts",
    "benchmark": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/benchmark.ts",
    "edge-cases": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/edge-cases.ts",
    "build:extension": "node scripts/build-extension.mjs",
    "warm": "tsx scripts/warm.ts",
    "snapshot": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/snapshot.ts && tsx scripts/showcase.ts",
    "benchmark:recognition": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/benchmark-recognition.ts",
    "a11y": "tsx scripts/a11y.ts",
    "showcase": "tsx scripts/showcase.ts",
    "screenshots": "tsx scripts/screenshots.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "next": "15.5.28",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.14.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "playwright": "^1.64.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.9"
  }
}
