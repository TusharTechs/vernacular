# Copy to .env.local (or .env) and fill in. Never commit either file.

# Required. Qloo hackathon key; it works only on the hackathon host below.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Required. Claude: reading copy, the swap agent, storyboards, comments, translator.
ANTHROPIC_API_KEY=

# Optional. OpenAI: Dial Test voice and video voiceover transcription. Without it,
# everything else works and those two features show a clear message.
OPENAI_API_KEY=
