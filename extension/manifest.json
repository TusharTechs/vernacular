{
  "manifest_version": 3,
  "name": "Vernacular Anywhere",
  "version": "0.1.0",
  "description": "A culture check for any text box: see which references land with your audience on Qloo's taste graph, and swap the ones that miss.",
  "permissions": ["storage"],
  "host_permissions": ["https://vernacular-lime.vercel.app/*"],
  "action": { "default_popup": "popup.html", "default_title": "Vernacular Anywhere" },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://localhost/*"],
      "js": ["config.js", "vernacular-anywhere.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
